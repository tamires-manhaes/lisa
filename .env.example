# lisa-listener — copy to `.env` and fill in the model path. Real env vars override `.env`.
# No secrets here (SPEC §10: dev tool on a trusted LAN).

# Port the Fastify listener binds to. Default: 8080. Change only if 8080 is taken.
PORT=8080

# URL of the whisper-server (scripts/run-whisper.sh, SPEC §5). Default: 127.0.0.1:8081. Change if whisper runs on another host/port.
WHISPER_URL=http://127.0.0.1:8081

# Path to the whisper.cpp model file (scripts/setup-whisper.sh downloads it). No default — REQUIRED. Change after setup to the downloaded model path.
WHISPER_MODEL_PATH=

# SQLite DB file location (persistence lands in later slices). Default: ~/Library/Application Support/lisa/lisa.db. Rarely changed.
LISA_DB_PATH=~/Library/Application Support/lisa/lisa.db

# Default inject mode when the request has no x-lisa-inject-strategy flag (SPEC §8). Default: paste. Use type for apps that block paste.
INJECT_STRATEGY=paste
